#!name=DNSGon-YouTubeApp-PrivateWorker
#!desc=Optional private UMP Worker bridge. Replace worker_url with your own deployed Worker before enabling.
#!author=DNSGon
#!arguments=worker_url:https://REPLACE-WITH-YOUR-WORKER.example/TOKEN
# Keep DNSGon-YouTubeApp-Community enabled for API response filtering.
# This module only redirects matching encrypted initplayback requests to your Worker.
# It does not grant Premium/background playback or change subscription responses.

[Rule]
AND,((PROTOCOL,UDP),(DEST-PORT,443),(DOMAIN-SUFFIX,googlevideo.com)),REJECT-NO-DROP

[Script]
DNSGon.PrivateInit = type=http-request,pattern=^https:\/\/(?:[a-z0-9-]+\.)*googlevideo\.com\/initplayback(?:\?[^#]*)?$,requires-body=1,binary-body-mode=1,max-size=4194304,engine=webview,timeout=10,script-path=https://raw.githubusercontent.com/HNam1234/dns-gon-filters/main/shadowrocket/youtube-private-worker-request.js,argument="worker_url={{{worker_url}}}",enable=true

[MITM]
h2 = true
hostname = %APPEND% *.googlevideo.com
